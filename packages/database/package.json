{
  "name": "@steward/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM schema, client, and SQL migrations for Steward XT.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrate": {
      "types": "./src/migrate.ts",
      "default": "./src/migrate.ts"
    }
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@steward/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@steward/config": "workspace:*",
    "@types/node": "^22.15.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}

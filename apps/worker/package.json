{
  "name": "@steward/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Steward XT BullMQ scheduling and background maintenance worker.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@steward/database": "workspace:*",
    "@steward/protocol": "workspace:*",
    "@steward/shared": "workspace:*",
    "bullmq": "^5.63.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@steward/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3"
  }
}

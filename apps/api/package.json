{
  "name": "@steward/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Steward XT Fastify API and node WebSocket gateway.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.0",
    "@steward/agents": "workspace:*",
    "@steward/database": "workspace:*",
    "@steward/protocol": "workspace:*",
    "@steward/shared": "workspace:*",
    "bullmq": "^5.63.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.2",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@steward/config": "workspace:*",
    "@steward/node": "workspace:*",
    "@steward/worker": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.0",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "ws": "^8.21.2"
  }
}

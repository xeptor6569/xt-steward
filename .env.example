# Steward XT — Docker Compose configuration.
# Copy to .env and adjust. Only POSTGRES_PASSWORD is strictly required.

# PostgreSQL password for the `steward` database user (required).
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Public hostname for the control plane. Leave empty for local evaluation
# (plain HTTP on http://localhost). Set to e.g. app.stewardxt.cc in
# production; Caddy will provision TLS for it automatically (the DNS record
# must already point at this machine).
STEWARD_DOMAIN=

# Exact browser origin of the dashboard. Must match how users reach it:
#   local evaluation:  http://localhost
#   production:        https://app.stewardxt.cc
STEWARD_WEB_ORIGIN=http://localhost

# Set to true when serving over HTTPS. Enables Secure cookies with the
# __Host- prefix. Leave false only for plain-HTTP local evaluation.
STEWARD_COOKIE_SECURE=false

# Backend log level: fatal | error | warn | info | debug | trace
STEWARD_LOG_LEVEL=info
